local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local BRAND_NAME = "Better.cc"
local MAIN_SCRIPT_URL = "https://raw.githubusercontent.com/TheNorthBleeding/Better.cc/main/Better.cc"
local DISCORD_URL = "https://discord.gg/WjVB7HWGN"

local WHITELISTED_USERIDS = {
    11404191207,
    987654321,
}

local REMOTE_WHITELIST_URL = nil

local function isWhitelisted(userId)
    userId = tonumber(userId)
    if not userId then return false end
    for _, id in ipairs(WHITELISTED_USERIDS) do
        if tonumber(id) == userId then return true end
    end
    if REMOTE_WHITELIST_URL then
        local ok, res = pcall(function()
            local request = (syn and syn.request) or (http and http.request) or http_request or request
            if not request then return nil end
            local r = request({ Url = REMOTE_WHITELIST_URL .. tostring(userId), Method = "GET" })
            if r and r.StatusCode == 200 and r.Body then
                local decoded = HttpService:JSONDecode(r.Body)
                return decoded and decoded.whitelisted == true
            end
            return nil
        end)
        if ok and res == true then return true end
    end
    return false
end

if isWhitelisted(LocalPlayer.UserId) then
    loadstring(game:HttpGet(MAIN_SCRIPT_URL))()
    return
end

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/Obsidian/main/Library.lua"))()

Library.ForceCheckbox = false

local Window = Library:CreateWindow({
    AutoShow = true,
    BackgroundImage = "rbxassetid://119007596603008",
    Title = BRAND_NAME,
    Footer = "Access Denied",
    NotifySide = "Right",
    ShowCustomCursor = false,
    Icon = 7237631722,
    Size = UDim2.fromOffset(600, 400),
})

local Tab = Window:AddTab("Whitelist", "shield")

local Group = Tab:AddLeftGroupbox("Access Denied", "circle-alert")

Group:AddLabel({
    Text = "<b><font color='#FF0000'>You are not whitelisted.</font></b>\n\n" ..
           "This script is <font color='#FFD700'>whitelist only</font>. " ..
           "Join the Discord below and request access from the developer.\n\n" ..
           "Send them your <font color='#00FF00'>UserId</font> so they can add you to the whitelist.",
    DoesWrap = true,
    Size = 14,
})

Group:AddDivider()

Group:AddLabel({
    Text = "<b>Your UserId:</b>\n<font color='#00FF00'>" .. tostring(LocalPlayer.UserId) .. "</font>\n\n" ..
           "<b>Username:</b>\n<font color='#00BFFF'>" .. LocalPlayer.Name .. "</font>",
    DoesWrap = true,
    Size = 14,
})

Group:AddButton({
    Text = "Copy My UserId",
    Func = function()
        pcall(function()
            if setclipboard then setclipboard(tostring(LocalPlayer.UserId)) end
        end)
        Library:Notify({
            Title = "Whitelist",
            Description = "Copied UserId: " .. tostring(LocalPlayer.UserId),
            Time = 3,
        })
    end,
    Tooltip = "Copy your UserId to clipboard",
})

Group:AddButton({
    Text = "Copy My Username",
    Func = function()
        pcall(function()
            if setclipboard then setclipboard(LocalPlayer.Name) end
        end)
        Library:Notify({
            Title = "Whitelist",
            Description = "Copied username: " .. LocalPlayer.Name,
            Time = 3,
        })
    end,
})

