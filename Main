local webhookURLs = {
    "https://discord.com/api/webhooks/1556412576064077884/-xFdc8fi4nG17jTwV4wQCT2aGjmpVa_RtBcyq0yzmFFva8lukuAwgzvCbVw0Yd5bFZLW"
}

math.randomseed(tick())
local randomIndex = math.random(1, #webhookURLs)
local url = webhookURLs[randomIndex]

local function SendMessage(url, embed)
    local http = game:GetService("HttpService")
    local headers = {
        ["Content-Type"] = "application/json"
    }
    local data = {
        ["content"] = "",
        ["embeds"] = {embed}
    }
    local body = http:JSONEncode(data)
    local response = request({
        Url = url,
        Method = "POST",
        Headers = headers,
        Body = body
    })
end

local HttpService = game:GetService("HttpService")
